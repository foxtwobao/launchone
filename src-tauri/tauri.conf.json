{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LaunchOne",
  "version": "0.2.3",
  "identifier": "com.tokenone.launchone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "LaunchOne",
      "width": 980,
      "height": 740,
      "minWidth": 680,
      "minHeight": 600,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": {"minimumSystemVersion": "12.0"}
  }
}
