# Non-secret publisher configuration. These values are not UI-editable.
# Development: export before npm run desktop. Release: set in build environment.
# Never embed an IDONE secret or RESELLER_APP_CREDENTIAL.
LAUNCHONE_IDONE_ISSUER=https://idone.lab.home.arpa
# Independent public client with Device login, Device Code and Refresh Token enabled.
LAUNCHONE_CLIENT_ID=
LAUNCHONE_SERVICE_URL=https://launchone.lab.home.arpa
# Codex base includes /v1; Claude base does not (adapter appends /v1/messages).
LAUNCHONE_CODEX_BASE_URL=https://tokenone.lab.home.arpa/v1
LAUNCHONE_CODEX_MODEL=
LAUNCHONE_CLAUDE_BASE_URL=https://tokenone.lab.home.arpa
LAUNCHONE_CLAUDE_MODEL=
