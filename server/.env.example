# Service-only configuration. Never include this file's real values in a desktop build.
NODE_ENV=production
HOST=127.0.0.1
PORT=55400
LAUNCHONE_PUBLIC_ORIGIN=https://launchone.lab.home.arpa
IDONE_ISSUER=https://idone.lab.home.arpa
RESELLER_ORIGIN=https://tokenonereseller.lab.home.arpa
RESELLER_GATEWAY_ORIGIN=https://gateway.lab.home.arpa
# Independent launchone application credential with keys:ensure scope.
RESELLER_APP_CREDENTIAL=
# Optional absolute path. Public Tauri updater manifest, signed by the release pipeline.
LAUNCHONE_UPDATE_MANIFEST_FILE=
# Dedicated public packages only; never point this at the source or private directory.
LAUNCHONE_UPDATE_ARTIFACT_DIRECTORY=
