# 这些配置只放在服务端 Docker 的 environment/env_file，或服务机的 server/.env。
# 不放到 GitHub 桌面打包变量中，也不写进客户端安装包。
NODE_ENV=production
# Docker 映射端口时设为 0.0.0.0；宿主机直接运行并使用反向代理时可保留 127.0.0.1。
HOST=127.0.0.1
PORT=55400
LAUNCHONE_PUBLIC_ORIGIN=https://launchone.lab.home.arpa
IDONE_ISSUER=https://idone.lab.home.arpa
# 提供给客户端的公开配置：前四项一起填写；账号网页可留空。
# IDONE 后台 → LaunchOne 应用 → Client ID，启用设备登录和刷新授权。
LAUNCHONE_CLIENT_ID=
# TokenOne 模型调用的 HTTPS 根地址，不加 /v1，应用会自动处理接口路径。
LAUNCHONE_TOKENONE_URL=https://tokenone.lab.home.arpa
# TokenOne 后台可用的请求模型名称，不是界面昵称。
LAUNCHONE_CODEX_MODEL=gpt-5.6-sol
LAUNCHONE_CLAUDE_MODEL=claude-sonnet-4-6
# 可选：TokenOne 账号、额度和充值网页。留空则隐藏入口。
LAUNCHONE_TOKENONE_PORTAL_URL=https://tokenone.lab.home.arpa/
# 改以上 env 后，重新创建 Docker 容器使新 env 生效；本机服务则重启进程。
# 客户端下次启动读取新值，无需重新打包。新模型用于下次连接 TokenOne。
RESELLER_ORIGIN=https://tokenonereseller.lab.home.arpa
RESELLER_GATEWAY_ORIGIN=https://gateway.lab.home.arpa
# LaunchOne 独立的服务端应用凭证（keys:ensure 权限），不能公开给客户端。
RESELLER_APP_CREDENTIAL=
# 可选：应用更新清单 latest.json 在服务机上的绝对路径。
LAUNCHONE_UPDATE_MANIFEST_FILE=
# 可选：更新安装包的专用目录，填服务机绝对路径，不要指向源码或私密目录。
LAUNCHONE_UPDATE_ARTIFACT_DIRECTORY=
# 可选：官方安装包镜像。下面两项一起填写，或一起留空关闭镜像。
# 下载地址填 HTTPS 根域名，目录填服务机绝对路径。
LAUNCHONE_DOWNLOAD_BASE_URL=
LAUNCHONE_INSTALLER_DIRECTORY=
