{
  "name": "launchone",
  "private": true,
  "version": "0.1.1",
  "description": "TokenOne 专用应用安装与配置助手",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:service": "node --test server/*.test.mjs",
    "service": "node --env-file=server/.env server/main.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "package:mac": "node --env-file-if-exists=.env.local scripts/package-macos.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "express": "^5.3.0",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
