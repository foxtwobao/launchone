# Komodo：将本文件内容粘贴到 Stack 的 Environment 栏，Compose 栏粘贴 compose.yml。
# 命令行部署：将本文件复制为 .env，与 compose.yml 放在同一个目录。
# 示例域名、客户端 ID、应用凭证必须替换；不需要填写任何苹果或更新签名私钥。

# 和 GitHub Secret DOCKERHUB_USERNAME 填同一个 Docker Hub 用户名。
DOCKERHUB_USERNAME=your-dockerhub-user

# LaunchOne 正式服务域名，必须与 GitHub desktop-release 的 LAUNCHONE_SERVICE_URL 相同。
LAUNCHONE_PUBLIC_ORIGIN=https://launchone.example.com

# IDONE 正式登录服务的 issuer，复制 /.well-known/openid-configuration 中的 issuer。
IDONE_ISSUER=https://idone.example.com
# IDONE 后台为 LaunchOne 登记的公开 Client ID，启用 Device login、Device Code、Refresh Token。
LAUNCHONE_CLIENT_ID=replace-with-launchone-production-client-id

# TokenOne 模型调用根域名，不加 /v1；两个模型名称须在正式分组中可用。
LAUNCHONE_TOKENONE_URL=https://tokenone.example.com
LAUNCHONE_CODEX_MODEL=gpt-5.6-sol
LAUNCHONE_CLAUDE_MODEL=claude-sonnet-4-6
# 可选：TokenOne 账号、额度和充值网页，留空则隐藏入口。
LAUNCHONE_TOKENONE_PORTAL_URL=

# 现有 Reseller 服务、授权网关的对外根域名，都不加接口路径。
RESELLER_ORIGIN=https://reseller.example.com
RESELLER_GATEWAY_ORIGIN=https://gateway.example.com
# Reseller 后台为 LaunchOne 创建的服务端应用凭证，权限 keys:ensure。
# 应用允许的 issuer 与 IDONE_ISSUER 一致；精确回调为：
# https://你的LaunchOne域名/auth/reseller/callback
# 保留单引号，避免凭证中的 $ 被 Compose 当成变量。
RESELLER_APP_CREDENTIAL='replace-with-launchone-production-app-credential'

# 以下功能等文件准备好后再启用；目前留空不影响登录和接入 TokenOne。
# 应用内更新：把清单和更新包放到宿主机 data/updates/，再填写下面两个路径。
# LAUNCHONE_UPDATE_MANIFEST_FILE=/data/updates/latest.json
# LAUNCHONE_UPDATE_ARTIFACT_DIRECTORY=/data/updates
LAUNCHONE_UPDATE_MANIFEST_FILE=
LAUNCHONE_UPDATE_ARTIFACT_DIRECTORY=

# 官方安装包镜像：完成验证和同步后，文件放到 data/installers/。
# 下载地址填映射到该目录的 HTTPS 根域名；下面两项一起填写。
# LAUNCHONE_DOWNLOAD_BASE_URL=https://downloads.example.com
# LAUNCHONE_INSTALLER_DIRECTORY=/data/installers
LAUNCHONE_DOWNLOAD_BASE_URL=
LAUNCHONE_INSTALLER_DIRECTORY=
