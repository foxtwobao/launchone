# LaunchOne-owned ingress, imported by the lab proxy.
http://launchone.lab.home.arpa {
    bind 192.168.10.38
    redir https://{host}{uri} 308
}

launchone.lab.home.arpa {
    bind 192.168.10.38
    tls internal
    reverse_proxy 127.0.0.1:55410
    # Authentication URLs contain one-time codes. Do not enable access/query logs.
}
