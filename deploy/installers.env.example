# Synchronizer-only secrets/configuration. Do not load this file in the HTTP service.
# Prepare the directory for the same Unix user/group as the read-only service.
LAUNCHONE_INSTALLER_DIRECTORY=/var/lib/launchone/installers
LAUNCHONE_INSTALLER_ENVIRONMENT=production
# A repository containing .github/workflows/verify-installers.yml and scripts.
LAUNCHONE_INSTALLER_GITHUB_REPOSITORY=owner/launchone
# Protected branch; the task captures its commit SHA and rejects a different run.
LAUNCHONE_INSTALLER_GITHUB_REF=main
LAUNCHONE_INSTALLER_GITHUB_WORKFLOW=verify-installers.yml
# Fine-grained token: Actions read/write (dispatch+run+artifact), Contents read
# (protected branch commit query), limited to the repository above.
LAUNCHONE_INSTALLER_GITHUB_TOKEN=
# Optional path updates restricted to the adapter's fixed official HTTPS hosts.
# LAUNCHONE_CODEX_MACOS_SOURCE_URL=https://persistent.oaistatic.com/codex-app-prod/ChatGPT.dmg
# LAUNCHONE_CLAUDE_MACOS_SOURCE_URL=https://downloads.claude.ai/releases/darwin/universal/latest/Claude.dmg
